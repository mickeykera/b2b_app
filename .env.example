# ---------------------------------------------------------------------------
# RelayFlow environment configuration
# Copy this file to `.env` and fill in real values before starting the app.
# The app validates this file at startup (env.mjs) and aborts with an
# explicit error if any required value is missing or invalid.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
# Fully-qualified base URL of this deployment (used for links, redirects).
APP_BASE_URL=https://app.example.com
APP_NAME=RelayFlow
# Outbound email. EMAIL_FROM is required by the Resend transport; leave
# EMAIL_RESEND_API_KEY empty to print messages to the console (development).
EMAIL_FROM=RelayFlow <noreply@relayflow.dev>
EMAIL_RESEND_API_KEY=

# --- Auth lifecycle --------------------------------------------------------
PASSWORD_RESET_TTL_HOURS=1
INVITE_TTL_DAYS=7

# --- Database (managed PostgreSQL over TLS, e.g. Neon/Supabase) ------------
# Connection-String used by the application (pooled endpoint recommended).
# Example (Neon):  postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/dbname?sslmode=require
# Example (Supabase): postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/relayflow?sslmode=disable

# Direct (non-pooled) connection used by CLI migrations. Optional for pooled
# providers that already support DDL over the pool.
DIRECT_URL=

# --- Redis (BullMQ queue + rate limiting; Upstash REDIS protocol endpoint) --
# Optional values shown mirror Upstash Redis TLS endpoint format.
REDIS_URL=rediss://default:password@us1-xxxx.upstash.io:6379

# --- Encryption at rest ----------------------------------------------------
# Master encryption key for AES-256-GCM secret encryption (lib/crypto.ts).
# Generate with:  openssl rand -base64 32
# MUST be a base64-encoded 32-byte value. Rotate carefully: existing secrets
# are wrapped with this key and become undecryptable if it is lost.
MASTER_ENCRYPTION_KEY=

# --- Authentication --------------------------------------------------------
# Symmetric JWT signing secret (HS256). Generate with: openssl rand -base64 48
AUTH_JWT_SECRET=

# Session lifetime in days.
AUTH_SESSION_TTL_DAYS=7

# --- Webhook ingestion security -------------------------------------------
# Max allowed age (seconds) of the timestamp included in signed webhooks.
# Older deliveries are rejected as suspected replays.
WEBHOOK_MAX_AGE_SECONDS=300

# Max accepted HTTP body size for webhook ingestion (bytes).
WEBHOOK_BODY_SIZE_LIMIT_BYTES=1000000

# --- Rate limiting ---------------------------------------------------------
# Token bucket dimensions applied on public API routes and webhook consumers.
RATE_LIMIT_IP_CAPACITY=120
RATE_LIMIT_IP_REFILL_PER_MINUTE=60
RATE_LIMIT_ORG_CAPACITY=600
RATE_LIMIT_ORG_REFILL_PER_MINUTE=300
RATE_LIMIT_WEBHOOK_CAPACITY=60
RATE_LIMIT_WEBHOOK_REFILL_PER_MINUTE=20

# --- Bootstrap (dev/seed only) ---------------------------------------------
# Used by `npm run db:seed` to create the initial organization + admin user.
BOOTSTRAP_ORG_NAME=Acme Inc
BOOTSTRAP_ORG_SLUG=acme
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=