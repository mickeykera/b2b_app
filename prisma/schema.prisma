generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// RelayFlow data model
//
// Multi-tenancy rules:
//   - Every tenant-owned model carries an `organizationId` column.
//   - Every READ/WRITE operation in the repository layer filters by
//     `organizationId`; there is no cross-tenant read path.
//   - Credentials and webhook secrets are stored as AES-256-GCM ciphertext
//     (see lib/crypto.ts). Plaintext secrets never touch Postgres.
//   - AuditLog is append-only; a database trigger blocks UPDATE/DELETE.
//
// Status fields are stored as strings with app-level zod enums so providers
// can evolve without foot-gun migrations.
// ---------------------------------------------------------------------------

model Organization {
  id              String               @id @default(cuid())
  name            String
  slug            String               @unique
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  users           User[]
  workflows       Workflow[]
  credentials     Credential[]
  runs            WorkflowRun[]
  stepLogs        StepLog[]
  deadLetters     DeadLetter[]
  auditLogs       AuditLog[]
  webhookEndpoints WebhookEndpoint[]
  triggers        Trigger[]
  actions         Action[]
  apiKeys         ApiKey[]
  invitations     Invitation[]

  @@map("organizations")
}

model User {
  id                String     @id @default(cuid())
  organizationId    String     @map("organization_id")
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email             String     @unique
  name              String?
  passwordHash      String     @map("password_hash")
  role              String     @default("member")
  mfaEnabled        Boolean    @default(false) @map("mfa_enabled")
  mfaSecretEncrypted String?   @map("mfa_secret_encrypted")
  recoveryCodesHash Json?      @map("recovery_codes_hash")
  passwordResetTokenHash String? @map("password_reset_token_hash")
  passwordResetExpiresAt DateTime? @map("password_reset_expires_at")
  lastLoginAt       DateTime?  @map("last_login_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  apiKeys           ApiKey[]
  sessions          Session[]
  invitedBy         Invitation[] @relation("InvitationBy")
  acceptedBy        Invitation[] @relation("InvitationAccepted")

  @@index([organizationId])
  @@map("users")
}

model Session {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique @map("token_hash")
  ipAddress   String?   @map("ip_address")
  userAgent   String?   @map("user_agent")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  lastUsedAt  DateTime  @default(now()) @map("last_used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Invitation {
  id               String     @id @default(cuid())
  organizationId   String     @map("organization_id")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email            String
  role             String     @default("member")
  tokenHash        String     @unique @map("token_hash")
  invitedById      String?    @map("invited_by_id")
  invitedBy        User?      @relation("InvitationBy", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedByUserId String?    @map("accepted_by_user_id")
  acceptedBy       User?      @relation("InvitationAccepted", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  expiresAt        DateTime   @map("expires_at")
  revokedAt        DateTime?  @map("revoked_at")
  acceptedAt       DateTime?  @map("accepted_at")
  createdAt        DateTime   @default(now()) @map("created_at")

  @@index([organizationId])
  @@index([email])
  @@map("invitations")
}

model Credential {
  id               String     @id @default(cuid())
  organizationId   String     @map("organization_id")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name             String
  provider         String
  secretCiphertext String     @db.Text @map("secret_ciphertext")
  secretIv         String     @map("secret_iv")
  maskedValue      String     @map("masked_value")
  metadata         Json?
  createdBy        String?    @map("created_by")
  lastUsedAt       DateTime?  @map("last_used_at")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  @@index([organizationId, provider])
  @@index([organizationId])
  @@map("credentials")
}

model Workflow {
  id               String     @id @default(cuid())
  organizationId   String     @map("organization_id")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  status           String     @default("draft")
  graph            Json
  version          Int        @default(1)
  createdBy        String?    @map("created_by")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  triggers         Trigger[]
  actions          Action[]
  runs             WorkflowRun[]
  deadLetters      DeadLetter[]
  webhookEndpoints WebhookEndpoint[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("workflows")
}

model Trigger {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflowId     String       @map("workflow_id")
  workflow       Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  nodeKey        String       @map("node_key")
  type           String
  config         Json
  enabled        Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([workflowId, nodeKey])
  @@index([organizationId, workflowId])
  @@index([type])
  @@map("triggers")
}

model Action {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflowId     String       @map("workflow_id")
  workflow       Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  nodeKey        String       @map("node_key")
  type           String
  config         Json
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([workflowId, nodeKey])
  @@index([organizationId, workflowId])
  @@index([type])
  @@map("actions")
}

model WorkflowRun {
  id              String      @id @default(cuid())
  organizationId  String      @map("organization_id")
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflowId      String      @map("workflow_id")
  workflow        Workflow    @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowVersion Int         @map("workflow_version")
  executionId     String      @unique @map("execution_id")
  status          String
  eventId         String?     @map("event_id")
  eventPayload    Json        @map("event_payload")
  triggerType     String?     @map("trigger_type")
  durationMs      Int?        @map("duration_ms")
  startedAt       DateTime?   @map("started_at")
  finishedAt      DateTime?   @map("finished_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  steps           StepLog[]

  @@unique([organizationId, executionId])
  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@index([organizationId, workflowId])
  @@map("workflow_runs")
}

model StepLog {
  id             String         @id @default(cuid())
  organizationId String         @map("organization_id")
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runId          String         @map("run_id")
  run            WorkflowRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  stepKey        String         @map("step_key")
  stepType       String         @map("step_type")
  label          String?
  status         String
  attempt        Int            @default(1)
  input          Json?
  output         Json?
  errorMessage   String?        @map("error_message")
  httpStatus     Int?           @map("http_status")
  durationMs     Int            @map("duration_ms")
  createdAt      DateTime       @default(now()) @map("created_at")

  @@index([organizationId, runId])
  @@index([organizationId, runId, createdAt])
  @@map("step_logs")
}

model DeadLetter {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflowId     String       @map("workflow_id")
  workflow       Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  runId          String?      @map("run_id")
  stepKey        String       @map("step_key")
  stepType       String       @map("step_type")
  payload        Json
  error          String       @db.Text
  attempts       Int
  source         String?
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@index([organizationId, workflowId])
  @@map("dead_letters")
}

model WebhookEndpoint {
  id                 String       @id @default(cuid())
  organizationId     String       @map("organization_id")
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflowId         String       @map("workflow_id")
  workflow           Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  triggerKey         String       @map("trigger_key")
  slug               String
  hmacSecretCiphertext String     @db.Text @map("hmac_secret_ciphertext")
  hmacSecretIv       String       @map("hmac_secret_iv")
  method             String       @default("POST")
  enabled            Boolean      @default(true)
  lastRequestAt      DateTime?    @map("last_request_at")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  @@unique([organizationId, slug])
  @@index([organizationId, workflowId])
  @@map("webhook_endpoints")
}

model AuditLog {
  id             String           @id @default(cuid())
  organizationId String?          @map("organization_id")
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorId        String?      @map("actor_id")
  action         String
  resourceType   String?      @map("resource_type")
  resourceId     String?      @map("resource_id")
  ipAddress      String?      @map("ip_address")
  metadata       Json?
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@index([organizationId, actorId])
  @@map("audit_logs")
}

model ApiKey {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  keyPrefix      String       @map("key_prefix")
  keyHash        String       @unique @map("key_hash")
  lastUsedAt     DateTime?    @map("last_used_at")
  revokedAt      DateTime?    @map("revoked_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([organizationId])
  @@map("api_keys")
}